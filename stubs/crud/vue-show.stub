<script setup lang="ts">
import { Head, setLayoutProps } from '@inertiajs/vue3';
import CrudFormPage from '@/components/crud/CrudFormPage.vue';
import { useTranslation } from '@/composables/useTranslation';
import type { CrudSchema } from '@/types/crud';
import { index as {{ resourceVariable }}Index } from '@/routes/{{ resource }}';

defineProps<{
    crud: CrudSchema;
    {{ entityVariable }}: {
        id: string | number;
    };
}>();

const { t } = useTranslation();

setLayoutProps({
    breadcrumbs: [
        {
            title: t('{{ title }}'),
            href: {{ resourceVariable }}Index(),
        },
        {
            title: t('View :name', { name: t('{{ entityVariable }}') }),
        },
    ],
});
</script>

<template>
    <Head :title="t('View {{ entityVariable }}')" />

    <CrudFormPage
        :schema="crud"
        :back-href="{{ resourceVariable }}Index()"
        :title="t('View {{ entityVariable }}')"
        :description="t('Review the :name details.', { name: t('{{ entityVariable }}') })"
        submit-label=""
        :initial-values="{{ entityVariable }}"
        :read-only="true"
    />
</template>
