<script setup lang="ts">
import { Head, setLayoutProps } from '@inertiajs/vue3';
import CrudPage from '@/components/crud/CrudPage.vue';
import { useTranslation } from '@/composables/useTranslation';
import type { CrudPaginator, CrudRecord, CrudSchema } from '@/types/crud';
import {
    create as create{{ entity }},
    destroy as destroy{{ entity }},
    edit as edit{{ entity }},
    index as {{ resourceVariable }}Index,
    show as show{{ entity }},
    store as store{{ entity }},
    update as update{{ entity }},
} from '@/routes/{{ resource }}';

type {{ entity }} = CrudRecord & {
    id: string | number;
    name: string;
    can: {
        show: boolean;
        update: boolean;
        delete: boolean;
    };
};

defineProps<{
    crud: CrudSchema;
    {{ pluralVariable }}: CrudPaginator<{{ entity }}>;
    can: {
        create: boolean;
    };
}>();

const { t } = useTranslation();

setLayoutProps({
    breadcrumbs: [
        {
            title: t('{{ title }}'),
            href: {{ resourceVariable }}Index(),
        },
    ],
});
</script>

<template>
    <Head :title="crud.title" />

    <CrudPage
        :schema="crud"
        :records="{{ pluralVariable }}"
        workspace="Workspace"
        :create="{
            can: can.create,
            href: create{{ entity }}(),
            action: store{{ entity }}.form(),
            label: t('Create :name', { name: t('{{ entityVariable }}') }),
            title: t('Create :name', { name: t('{{ entityVariable }}') }),
            description: t('Add a new :name.', { name: t('{{ entityVariable }}') }),
        }"
        :edit="{
            action: (record) => update{{ entity }}.form.patch(record.id),
            href: (record) => edit{{ entity }}(record.id),
            can: (record) => record.can.update,
            title: () => t('Edit {{ entityVariable }}'),
            description: t('Update the :name details.', { name: t('{{ entityVariable }}') }),
        }"
        :show="{
            href: (record) => show{{ entity }}(record.id),
            can: (record) => record.can.show,
            title: () => t('View {{ entityVariable }}'),
        }"
        :destroy="{
            action: (record) => destroy{{ entity }}.form.delete(record.id),
            can: (record) => record.can.delete,
            title: (record) => t('Delete :name?', { name: String(record.name) }),
        }"
    >
        <template #cell-name="{ value }">
            <span class="font-medium">{{ value }}</span>
        </template>
    </CrudPage>
</template>
