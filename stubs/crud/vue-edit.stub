<script setup lang="ts">
import { Head } from '@inertiajs/vue3';
import CrudFormPage from '@/components/crud/CrudFormPage.vue';
import { useTranslation } from '@/composables/useTranslation';
import type { CrudSchema } from '@/types/crud';
import { index as {{ resourceVariable }}Index, update as update{{ entity }} } from '@/routes/{{ resource }}';

defineProps<{
    crud: CrudSchema;
    {{ entityVariable }}: {
        id: string | number;
    };
}>();

const { t } = useTranslation();

defineOptions({
    layout: {
        breadcrumbs: [
            {
                title: '{{ title }}',
                href: {{ resourceVariable }}Index(),
            },
            {
                title: 'Edit {{ entityVariable }}',
            },
        ],
    },
});
</script>

<template>
    <Head :title="t('Edit {{ entityVariable }}')" />

    <CrudFormPage
        :schema="crud"
        :action="update{{ entity }}.form.patch({{ entityVariable }}.id)"
        :back-href="{{ resourceVariable }}Index()"
        :title="t('Edit {{ entityVariable }}')"
        :description="t('Update the :name details.', { name: t('{{ entityVariable }}') })"
        :submit-label="t('Save changes')"
        :initial-values="{{ entityVariable }}"
    />
</template>
