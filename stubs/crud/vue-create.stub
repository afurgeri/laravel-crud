<script setup lang="ts">
import { Head, setLayoutProps } from '@inertiajs/vue3';
import CrudFormPage from '@/components/crud/CrudFormPage.vue';
import { useTranslation } from '@/composables/useTranslation';
import type { CrudSchema } from '@/types/crud';
import { index as {{ resourceVariable }}Index, store as store{{ entity }} } from '@/routes/{{ resource }}';

defineProps<{
    crud: CrudSchema;
}>();

const { t } = useTranslation();

setLayoutProps({
    breadcrumbs: [
        {
            title: t('{{ title }}'),
            href: {{ resourceVariable }}Index(),
        },
        {
            title: t('Create :name', { name: t('{{ entityVariable }}') }),
        },
    ],
});
</script>

<template>
    <Head :title="t('Create :name', { name: t('{{ entityVariable }}') })" />

    <CrudFormPage
        :schema="crud"
        :action="store{{ entity }}.form()"
        :back-href="{{ resourceVariable }}Index()"
        :title="t('Create :name', { name: t('{{ entityVariable }}') })"
        :description="t('Add a new :name.', { name: t('{{ entityVariable }}') })"
        :submit-label="t('Create :name', { name: t('{{ entityVariable }}') })"
    >
        <template #fields="slotProps">
            <slot name="fields" v-bind="slotProps" />
        </template>
    </CrudFormPage>
</template>
